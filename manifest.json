{
	"manifest_version": 2.0,
	"id": "future_park",
	"type": "widget",
	"name": "Future Parking",
	"namespace": "FuturePark",
	"version": "1.0",
	"author": "Future Inc.",
	"description": "Displays parking space occupancy in a parking lot.",
	"widget": {
		"js_class": "FuturePark",
        "in": {
			"groupid": {
				"type": "_hostgroupid",
				"required": true
			}
		}
	},
	"assets": {
		"js": ["class.widget.js"],
		"css": ["widget.css"]
	}
}
